{
  "name": "uml-live-editor",
  "productName": "UML Live",
  "version": "1.0.1",
  "description": "A lightweight Windows desktop tool that renders PlantUML and Mermaid diagrams live, side by side with your code.",
  "type": "module",
  "main": "electron/main.js",
  "author": "UML Live",
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/copy-assets.mjs && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "smoke": "node scripts/smoke-test.mjs",
    "postinstall": "node scripts/copy-assets.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.5.12",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@lezer/highlight": "^1.2.2",
    "@plantuml/core": "^1.2026.9",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "mermaid": "^12.2.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.umllive.editor",
    "productName": "UML Live",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UML Live",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
